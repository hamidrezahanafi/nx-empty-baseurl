{
  "compilerOptions": {
    "paths": {
      "@test-app/*": [
        "./test-app/src/*"
      ],
      "@tools/my-plugin/*": [
        "./tools/my-plugin/src/*"
      ],
      "@tools/my-plugin": [
        "./tools/my-plugin/src"
      ]
    },
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "development"
    ]
  }
}
